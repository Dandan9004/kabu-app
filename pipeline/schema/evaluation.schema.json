{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly 7-expert evaluations written by the Claude routine",
  "type": "object",
  "required": ["date", "items"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["code", "power", "cheapness", "headline", "summary", "weakness", "experts"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^[0-9A-Z]{4}$"},
          "power": {"type": "integer", "minimum": 1, "maximum": 5},
          "cheapness": {"type": "integer", "minimum": 1, "maximum": 5},
          "headline": {"type": "string", "minLength": 4, "maxLength": 20},
          "summary": {"type": "string", "minLength": 20, "maxLength": 120},
          "weakness": {
            "type": "object",
            "required": ["severity", "points"],
            "additionalProperties": false,
            "properties": {
              "severity": {"enum": ["大", "中", "小"]},
              "points": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 6, "maxLength": 60}}
            }
          },
          "experts": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["role", "tag", "score", "why"],
              "additionalProperties": false,
              "properties": {
                "role": {"enum": ["事業の目利き", "決算の読み手", "成長の見張り", "業界と景気", "株主目線", "値段の番人"]},
                "tag": {"enum": ["power", "cheapness"]},
                "score": {"type": "integer", "minimum": 1, "maximum": 5},
                "why": {"type": "string", "minLength": 10, "maxLength": 90}
              }
            }
          },
          "news_gists": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 60}}
        }
      }
    }
  }
}
